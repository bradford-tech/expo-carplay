{
  "name": "expo-carplay-example",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "format": "prettier --write --cache --log-level warn \"**/*.{js,jsx,ts,tsx,json}\"",
    "postinstall": "patch-package",
    "ios": "expo run:ios --device",
    "lint": "expo lint . --fix -- --max-warnings=0",
    "prebuild": "expo prebuild --clean --platform ios",
    "start": "expo start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bradford-tech/expo-carplay": "file:..",
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^58.0.0",
    "globals": "^17.4.0",
    "patch-package": "^8.0.1",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
